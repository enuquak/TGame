<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TGame.EngineTests" />
    <Compile Include="../model/entities/**/*.cs" />
    <Compile Include="../logic/**/*.cs" />
    <ProjectReference Include="../engine/TGame.Server.Engine.csproj" />
    <ProjectReference Include="../../shared/TGame.Shared.csproj" />
    <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.31" />
    <Content Include="../config/*.yaml" Link="config/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
