<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TGame.SinglePointTests" />
    <Compile Include="../model/entities/**/*.cs" />
    <Compile Include="../logic/**/*.cs" />
    <ProjectReference Include="../engine/TGame.Server.Engine.csproj" />
    <ProjectReference Include="../../shared/TGame.Shared.csproj" />
    <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.31" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <Content Include="../config/server.local.yaml" Link="config/server.local.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../config/dbmgr-storage.yaml" Link="config/dbmgr-storage.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../config/id-generator.json" Link="config/id-generator.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../config/zookeeper.json" Link="config/zookeeper.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../config/connections.json" Link="config/connections.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
