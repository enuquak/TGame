{
  "uid": "tgame-environment",
  "title": "TGame 环境监控",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "title": "Prometheus 抓取状态", "type": "stat", "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 }, "datasource": { "type": "prometheus", "uid": "tgame-prometheus" }, "targets": [{ "refId": "A", "expr": "up", "legendFormat": "{{job}}" }] },
    { "id": 2, "title": "Prometheus 内存", "type": "timeseries", "gridPos": { "x": 8, "y": 0, "w": 16, "h": 6 }, "datasource": { "type": "prometheus", "uid": "tgame-prometheus" }, "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }, "targets": [{ "refId": "A", "expr": "process_resident_memory_bytes{job=\"prometheus\"}" }] },
    { "id": 3, "title": "采集范围", "type": "text", "gridPos": { "x": 0, "y": 6, "w": 24, "h": 4 }, "options": { "mode": "markdown", "content": "当前显示 Prometheus 自身的真实指标。游戏服、数据库和宿主机指标需在各自 exporter 或指标端点接入后增加。" } }
  ]
}
