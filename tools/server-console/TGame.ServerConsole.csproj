<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TGame.ServerConsole</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ServerConsole.Check" />
    <Compile Include="../../code/shared/csharp/*.cs" LinkBase="Shared" />
    <Compile Include="../../code/shared/configuration/*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
