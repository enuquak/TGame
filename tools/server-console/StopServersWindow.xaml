<Window x:Class="TGame.ServerConsole.StopServersWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭服务器" Width="430" Height="500" MinWidth="370" MinHeight="400"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Background="#F5F7F8"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Window.Resources><ResourceDictionary Source="ConsoleTheme.xaml"/></Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="选择要关闭的进程" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
            <DockPanel Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="全选" Padding="8,3" Click="SelectAll"/><Button Content="取消选择" Padding="8,3" Margin="5,0,0,0" Click="DeselectAll"/>
                </StackPanel>
                <TextBlock x:Name="CountLabel" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button IsCancel="True" Content="取消" MinWidth="65" Margin="0,0,8,0"/>
            <Button x:Name="Confirm" Content="关闭所选" Foreground="White" Background="#9B4239" BorderBrush="#9B4239"
                    IsEnabled="False" Click="ConfirmStop"/>
        </StackPanel>
        <ListBox x:Name="Choices" SelectionMode="Multiple" BorderBrush="{StaticResource Line}" BorderThickness="1" SelectionChanged="SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem"><Setter Property="IsEnabled" Value="{Binding CanStop}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="9,6"/></Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><DockPanel>
                <TextBlock Text="{Binding Description}" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
                <CheckBox IsHitTestVisible="False" Focusable="False" Content="{Binding Role}"
                          IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"/>
            </DockPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
